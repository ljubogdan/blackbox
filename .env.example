# With no key set, Blackbox runs on a rule-based stand-in model (scripted mode).
# Set ONE provider key to run the investigators and the arbiter on a real model.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Optional overrides
# INVESTIGATOR_MODEL=claude-haiku-4-5
# ARBITER_MODEL=claude-sonnet-4-6
# BLACKBOX_MODE=scripted        # force the stand-in model even if a key is set
# MAX_CASES=12                  # live mode: stop opening disputes after this many (bounds model spend)
# APPROVAL_THRESHOLD=1000       # rulings on orders at or above this amount (EUR) wait for a human
# MAX_AWAITING=2               # once this many rulings wait for a person, new disputes are kept to small orders
# FAULT_RATE=0.15               # scripted mode: share of first submissions with a deliberately wrong citation
# SEED=20261127
# ENGINE_PORT=8787
# MAX_RPM=5                    # space model calls to stay under a requests-per-minute quota (free tiers)
# FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash   # used in order when the chosen model is out of quota or overloaded; empty for none
# PROOF_TIMEOUT_S=900          # how long `npm run proof` waits (default 240 scripted, 900 live)
